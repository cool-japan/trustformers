# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# Editor / refactoring-tool leftovers next to a live source file.
# NOTE: the three `*..rs.*` patterns that used to live here had a stray double
# dot and therefore matched nothing, which is how a dozen `*.rs.conflict_backup`
# and `*.rs.bak_refactored` files ended up tracked in git. Keep these anchored on
# a single dot, and keep the `*_<suffix>` variants that splitrs / migration
# scripts produce.
**/*.rs.bk
**/*.rs.bak
**/*.rs.bak[0-9]
**/*.rs.backup
**/*.rs.old
**/*.rs.orig
**/*.rs.rej
**/*_backup.rs
**/*.rs.conflict_backup
**/*.rs.orig_backup
**/*.rs.rej_backup
**/*.rs.bak_original
**/*.rs.bak_refactored
**/*.rs.prelude_fix
**/*.rs.policy_fix
# Agent scratch directories and notebook checkpoints. (The two patterns that used
# to sit here — `**/ .claude/` and `**/ .ipynb_checkpoints/` — carried a stray
# space after `**/` and therefore matched nothing; the unanchored forms below
# already match at every directory level, which is what was actually keeping
# `.claude/worktrees/**` out of the index.)
.claude/
.ipynb_checkpoints/

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# MacOS
.DS_Store

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Python cache (for any Python scripts or tools)
__pycache__/
*.py[cod]
*$py.class

# Environment variables
.env
.env.local

# Model weights and data
*.bin
*.pt
*.pth
*.safetensors
*.onnx
*.ggml

# Test coverage
tarpaulin-report.html
cobertura.xml
coverage/

# Benchmark results
criterion/

# Documentation
/target/doc/

# Temporary files
*.tmp
*.temp
/tmp/
*.bak
*.backup
*.old
*.orig
*.bak2
*.bak3
*.bak4
*.*_bak
*.*_bak2
*.*_bak3
*.*_bak4
*.rs.*_fix


# Node
**/node_modules/*
node_modules/
npm-debug.log

# Debugging plots
trustformers-debug/modern_debug_plots

# Memory reports (generated)
**/memory_reports/

# miscs
trustformers-py/test_results

# CLAUDE
**/CLAUDE.md
**/.claude/

# Rustc ICE dumps
rustc-ice-*.txt

target
